# =================================================================
# GEOGRAPHY EDU - MAU BIEN MOI TRUONG (ENVIRONMENT TEMPLATE)
# =================================================================
# Cach dung:
#   1. Copy file nay thanh ".env" (cung thu muc goc).
#   2. Dien gia tri that vao ".env".
#   3. Chay "npm run build" - script se doc ".env" va sinh ra
#      "js/env-config.js" (KHONG commit len Git) de trang web doc.
#   4. Moi lan doi ".env" phai chay lai "npm run build".
#
# ".env" va "js/env-config.js" da duoc khai bao trong .gitignore, khong bao
# gio commit 2 file nay len Git.
# =================================================================

# Google Gemini API Key (dung cho tro ly AI Dia li & dich thuat)
GEMINI_API_KEY=your_gemini_api_key_here

# Cau hinh du an Firebase (Project Settings > General > Your apps > SDK setup)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
